# GoldBot environment configuration
# Copy to .env and fill in values. Never commit .env to version control.
#
# NOTE: the application reads settings via the GOLD_ prefix (see
# src/goldbot/core/config.py). Values in config/settings.yaml override these
# defaults; environment variables of the form GOLD_<FIELD> override the YAML.

# Mode: paper or live (live requires verified instrument metadata)
GOLD_MODE=paper

# Instrument - set these before enabling live trading
GOLD_INSTRUMENT_SYMBOL=XAUUSD
GOLD_INSTRUMENT_VENUE=
GOLD_ASSET_TYPE=spot
GOLD_METADATA_VERIFIED=false

# Market data
GOLD_MARKET_DATA_PROVIDER=csv

# Database (optional). Used only when present, e.g. Alembic migrations and
# the opt-in DB mirror. Leave unset to run fully in-memory + JSON ledger.
# GOLD_DATABASE_URL=postgresql+psycopg://goldbot:password@localhost:5432/goldbot

# Application extras (informational)
APP_ENV=development
APP_TIMEZONE=UTC
LOG_LEVEL=INFO